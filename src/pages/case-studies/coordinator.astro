---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Contact from "../../components/Contact.astro";

const project = {
  company: "Coordinator",
  client: "GIFT University",
  role: "Software Engineer",
  period: "2019 – 2020",
  color: "#6366f1",
  icon: "🎓",
  tagline:
    "Three bespoke academic dashboards for university programme coordinators.",
  overview:
    "During my time at GIFT University, I built a Coordinator management system featuring three distinct dashboards tailored to different academic stakeholders: Master's programme coordinators, BS programme coordinators, and university administrators. This was one of my earliest full-stack projects, where I practised end-to-end software delivery — from requirements gathering to implementation.",
  problem:
    "GIFT University coordinators managed student registration, timetabling, and academic progress through fragmented spreadsheets and manual processes. There was no unified system providing role-appropriate views and actions for different coordinator types, leading to errors, duplication, and poor visibility.",
  tags: [
    "Dashboard Design",
    "Requirements Gathering",
    "University ERP",
    "Full-Stack",
  ],
  stack: [
    { label: "Full-Stack", value: "Ruby on Rails / Web Framework", icon: "💎" },
    { label: "Database", value: "PostgreSQL / MySQL", icon: "🐘" },
    { label: "UI", value: "Custom Dashboards (3 roles)", icon: "🎨" },
    { label: "Process", value: "Requirements Gathering & Design", icon: "📋" },
  ],
  responsibilities: [
    {
      title: "Requirements Gathering",
      desc: "Conducted in-depth interviews and workshops with Master's and BS programme coordinators to understand their workflows, pain points, and data needs.",
      icon: "🧩",
    },
    {
      title: "Stakeholder Design",
      desc: "Designed three distinct dashboards tailored to different coordinator roles, ensuring each view surfaced only role-relevant data and actions.",
      icon: "🎨",
    },
    {
      title: "Full Development",
      desc: "Built the complete application from requirements to deployment, implementing authentication, role-based access control, and all coordinator workflows.",
      icon: "⚙️",
    },
    {
      title: "University Integration",
      desc: "Integrated with existing university data sources to surface student records, course schedules, and registration data within the coordinator dashboards.",
      icon: "🔌",
    },
  ],
  outcomes: [
    { value: "3", label: "Tailored dashboards delivered" },
    { value: "100%", label: "Requirements-driven design" },
    { value: "↓", label: "Manual coordination overhead" },
  ],
  challenges: [
    {
      title: "Role-Specific UX Design",
      desc: "Each coordinator role had fundamentally different data needs and workflows. I designed a shared component foundation with role-based rendering, avoiding three completely separate codebases while still providing each user the focused view they needed.",
    },
    {
      title: "Translating Non-Technical Requirements",
      desc: "Academic coordinators had no technical background, so bridging the gap between their workflow descriptions and formal software requirements was a core challenge — solved through iterative prototyping and regular feedback sessions.",
    },
    {
      title: "Data Integrity for Academic Records",
      desc: "Student and programme data required strict validation and audit trails. I implemented database-level constraints, form-level validations, and activity logging to ensure data accuracy and accountability.",
    },
  ],
};
---

<Layout
  title={`${project.company} Case Study | Saim Sohail`}
  description={project.tagline}
>
  <Header />
  <main>
    <section class="cs-detail-hero" style={`--accent: ${project.color};`}>
      <div class="container">
        <a href="/case-studies" class="back-link">← All Case Studies</a>
        <div class="hero-meta">
          <span class="hero-icon">{project.icon}</span>
          <div>
            <p class="hero-role">{project.role} · {project.client}</p>
            <h1 class="hero-company">{project.company}</h1>
            <p class="hero-period">{project.period}</p>
          </div>
        </div>
        <p class="hero-tagline">{project.tagline}</p>
        <div class="hero-tags">
          {project.tags.map((t) => <span class="htag">{t}</span>)}
        </div>
      </div>
    </section>

    <section class="cs-body">
      <div class="container cs-layout">
        <div class="cs-main">
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">📋</span> Project Overview
            </h2>
            <p class="block-text">{project.overview}</p>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🎯</span> The Problem
            </h2>
            <p class="block-text">{project.problem}</p>
          </div>

          <!-- Dashboard Roles -->
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🗂️</span> Three Dashboards, Three Roles
            </h2>
            <div class="role-cards">
              <div class="role-card" style="--rc: #6366f1;">
                <span class="rc-icon">🧑‍💼</span>
                <h3>Master's Coordinator</h3>
                <p>
                  Graduate programme management, student progress tracking,
                  thesis coordination, and academic scheduling for postgraduate
                  cohorts.
                </p>
              </div>
              <div class="role-card" style="--rc: #8b5cf6;">
                <span class="rc-icon">👩‍🎓</span>
                <h3>BS Coordinator</h3>
                <p>
                  Undergraduate registration management, semester planning,
                  attendance oversight, and inter-department coordination for BS
                  programmes.
                </p>
              </div>
              <div class="role-card" style="--rc: #06b6d4;">
                <span class="rc-icon">🏫</span>
                <h3>University Admin</h3>
                <p>
                  University-wide view covering all programmes, coordinator
                  performance, aggregate reporting, and system configuration.
                </p>
              </div>
            </div>
          </div>

          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">⚡</span> My Responsibilities
            </h2>
            <div class="resp-grid">
              {
                project.responsibilities.map((r) => (
                  <div class="resp-card">
                    <span class="resp-icon">{r.icon}</span>
                    <div>
                      <h3 class="resp-title">{r.title}</h3>
                      <p class="resp-desc">{r.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🧩</span> Key Challenges & Solutions
            </h2>
            <div class="challenge-list">
              {
                project.challenges.map((c, i) => (
                  <div class="challenge-item">
                    <div class="challenge-num">{i + 1}</div>
                    <div>
                      <h3 class="challenge-title">{c.title}</h3>
                      <p class="challenge-desc">{c.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <aside class="cs-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">🏆 Outcomes</h3>
            <div class="outcomes">
              {
                project.outcomes.map((o) => (
                  <div class="outcome-item">
                    <span class="outcome-value">{o.value}</span>
                    <span class="outcome-label">{o.label}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="sidebar-card">
            <h3 class="sidebar-title">🛠️ Tech Stack</h3>
            <div class="stack-list">
              {
                project.stack.map((s) => (
                  <div class="stack-item">
                    <span class="stack-icon">{s.icon}</span>
                    <div>
                      <p class="stack-label">{s.label}</p>
                      <p class="stack-value">{s.value}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="sidebar-card sidebar-cta">
            <p class="cta-text">
              Need a custom dashboard or internal tool built for your
              organisation?
            </p>
            <a href="/#contact" class="cta-btn">Let's Talk</a>
          </div>
        </aside>
      </div>
    </section>
    <Contact />
  </main>
</Layout>

<style>
  :root {
    --accent: #6366f1;
  }
  .cs-detail-hero {
    padding-top: 140px;
    padding-bottom: 4rem;
    background: radial-gradient(
      ellipse 80% 50% at 50% 0%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 60%
    );
    border-bottom: 1px solid var(--glass-border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    transition: color 0.25s;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .hero-icon {
    font-size: 3.5rem;
    filter: drop-shadow(0 0 20px var(--accent));
  }
  .hero-role {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .hero-company {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-color);
    line-height: 1.1;
  }
  .hero-period {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .hero-tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .htag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }
  .cs-body {
    padding: 4rem 0 6rem;
  }
  .cs-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }
  .cs-block {
    margin-bottom: 3rem;
  }
  .block-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .block-text {
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .role-cards {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }
  .role-card {
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--rc) 30%, transparent);
    background: color-mix(in srgb, var(--rc) 8%, transparent);
  }
  .rc-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  .role-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .role-card p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .resp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .resp-card {
    display: flex;
    gap: 0.9rem;
    padding: 1.25rem;
    border-radius: 0.9rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .resp-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .resp-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .resp-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .resp-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .challenge-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .challenge-num {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .challenge-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .challenge-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .cs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 100px;
  }
  .sidebar-card {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
  }
  .sidebar-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--glass-border);
  }
  .outcomes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .outcome-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .outcome-value {
    font-size: 1.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .outcome-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stack-icon {
    font-size: 1.25rem;
  }
  .stack-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .stack-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-color);
  }
  .sidebar-cta {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 15%, transparent),
      color-mix(in srgb, #8b5cf6 10%, transparent)
    );
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    text-align: center;
  }
  .cta-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .cta-btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  @media (max-width: 900px) {
    .cs-layout {
      grid-template-columns: 1fr;
    }
    .cs-sidebar {
      position: static;
    }
    .resp-grid,
    .role-cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
