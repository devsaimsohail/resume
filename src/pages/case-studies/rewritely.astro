---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Contact from "../../components/Contact.astro";

const project = {
  company: "Rewritely",
  client: "Devsloop",
  role: "Sr. Software Engineer",
  period: "2024 – 2026",
  color: "#8b5cf6",
  icon: "✍️",
  tagline: "AI-powered rewriting platform — built from zero to production.",
  overview:
    "Rewritely is a SaaS platform that leverages AI to help content creators and businesses rewrite, rephrase, and humanise text at scale. I was brought in as the lead engineer to architect and build the entire product from scratch — full-stack, end to end.",
  problem:
    "The client needed a production-grade AI writing tool with robust subscription billing, third-party AI API integrations, and a scalable backend — all delivered in a rapid timeline with a small team of junior developers.",
  tags: [
    "NestJS",
    "Next.js",
    "MongoDB",
    "Stripe",
    "Recurly",
    "TypeScript",
    "REST APIs",
  ],
  stack: [
    { label: "Backend", value: "NestJS (Node.js)", icon: "🏗️" },
    { label: "Frontend", value: "Next.js (React)", icon: "⚛️" },
    { label: "Database", value: "MongoDB", icon: "🍃" },
    { label: "Payments", value: "Stripe + Recurly", icon: "💳" },
    { label: "AI Integration", value: "Third-party AI APIs", icon: "🤖" },
    { label: "DevOps", value: "CI/CD & Deployment", icon: "🚀" },
  ],
  responsibilities: [
    {
      title: "Built from Scratch",
      desc: "Designed and implemented the complete system architecture — from database schemas to API contracts — with no legacy code to inherit.",
      icon: "🏗️",
    },
    {
      title: "Dual Payment Gateway Integration",
      desc: "Integrated both Stripe and Recurly for flexible subscription management, one-time purchases, and enterprise billing flows with webhook handling.",
      icon: "💳",
    },
    {
      title: "AI API Integration",
      desc: "Connected multiple third-party AI APIs to power the core rewriting, paraphrasing, and humanisation features while abstracting vendor-specific logic for easy swapping.",
      icon: "🧠",
    },
    {
      title: "Team Leadership & Mentorship",
      desc: "Managed a team of junior developers — setting coding standards, conducting daily standups, and unblocking teammates on complex tasks.",
      icon: "👥",
    },
    {
      title: "Code Reviews",
      desc: "Maintained code quality through rigorous PR reviews, establishing review guidelines and automated lint/test checks.",
      icon: "🔍",
    },
    {
      title: "Smooth Deployment Process",
      desc: "Established a CI/CD pipeline ensuring zero-downtime deployments, environment-specific configs, and reliable rollback strategies.",
      icon: "🚀",
    },
  ],
  outcomes: [
    { value: "0 → 1", label: "Full product built from scratch" },
    { value: "2", label: "Payment gateways integrated" },
    { value: "100%", label: "Architecture ownership" },
  ],
  challenges: [
    {
      title: "Vendor Abstraction for AI APIs",
      desc: "With multiple AI providers in the market, I built an abstraction layer so the platform could switch or combine AI vendors without rewriting core business logic.",
    },
    {
      title: "Billing Complexity",
      desc: "Supporting both Stripe and Recurly simultaneously required careful webhook deduplication, idempotency handling, and per-user subscription state management.",
    },
    {
      title: "Scaling a Junior Team",
      desc: "Balancing personal delivery commitments with mentoring junior developers required structured code review cadences and clear task decomposition.",
    },
  ],
};
---

<Layout
  title={`${project.company} Case Study | Saim Sohail`}
  description={project.tagline}
>
  <Header />
  <main>
    <!-- Hero Banner -->
    <section class="cs-detail-hero" style={`--accent: ${project.color};`}>
      <div class="container">
        <a href="/case-studies" class="back-link"> ← All Case Studies </a>
        <div class="hero-meta">
          <span class="hero-icon">{project.icon}</span>
          <div>
            <p class="hero-role">{project.role} · {project.client}</p>
            <h1 class="hero-company">{project.company}</h1>
            <p class="hero-period">{project.period}</p>
          </div>
        </div>
        <p class="hero-tagline">{project.tagline}</p>
        <div class="hero-tags">
          {project.tags.map((t) => <span class="htag">{t}</span>)}
        </div>
      </div>
    </section>

    <section class="cs-body">
      <div class="container cs-layout">
        <!-- Main Content -->
        <div class="cs-main">
          <!-- Overview -->
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">📋</span> Project Overview
            </h2>
            <p class="block-text">{project.overview}</p>
          </div>

          <!-- Problem -->
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🎯</span> The Problem
            </h2>
            <p class="block-text">{project.problem}</p>
          </div>

          <!-- Responsibilities -->
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">⚡</span> My Responsibilities
            </h2>
            <div class="resp-grid">
              {
                project.responsibilities.map((r) => (
                  <div class="resp-card">
                    <span class="resp-icon">{r.icon}</span>
                    <div>
                      <h3 class="resp-title">{r.title}</h3>
                      <p class="resp-desc">{r.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Challenges -->
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🧩</span> Key Challenges & Solutions
            </h2>
            <div class="challenge-list">
              {
                project.challenges.map((c, i) => (
                  <div class="challenge-item">
                    <div class="challenge-num">{i + 1}</div>
                    <div>
                      <h3 class="challenge-title">{c.title}</h3>
                      <p class="challenge-desc">{c.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="cs-sidebar">
          <!-- Outcomes -->
          <div class="sidebar-card">
            <h3 class="sidebar-title">🏆 Outcomes</h3>
            <div class="outcomes">
              {
                project.outcomes.map((o) => (
                  <div class="outcome-item">
                    <span class="outcome-value">{o.value}</span>
                    <span class="outcome-label">{o.label}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Tech Stack -->
          <div class="sidebar-card">
            <h3 class="sidebar-title">🛠️ Tech Stack</h3>
            <div class="stack-list">
              {
                project.stack.map((s) => (
                  <div class="stack-item">
                    <span class="stack-icon">{s.icon}</span>
                    <div>
                      <p class="stack-label">{s.label}</p>
                      <p class="stack-value">{s.value}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- CTA -->
          <div class="sidebar-card sidebar-cta">
            <p class="cta-text">
              Interested in working together on a SaaS product?
            </p>
            <a href="/#contact" class="cta-btn">Let's Talk</a>
          </div>
        </aside>
      </div>
    </section>

    <Contact />
  </main>
</Layout>

<style>
  :root {
    --accent: #8b5cf6;
  }

  /* ── Hero ── */
  .cs-detail-hero {
    padding-top: 140px;
    padding-bottom: 4rem;
    background: radial-gradient(
      ellipse 80% 50% at 50% 0%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 60%
    );
    border-bottom: 1px solid var(--glass-border);
    position: relative;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    transition: color 0.25s;
  }
  .back-link:hover {
    color: var(--accent);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-icon {
    font-size: 3.5rem;
    filter: drop-shadow(0 0 20px var(--accent));
  }

  .hero-role {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .hero-company {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-color);
    line-height: 1.1;
  }

  .hero-period {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .hero-tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .htag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  /* ── Body Layout ── */
  .cs-body {
    padding: 4rem 0 6rem;
  }

  .cs-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }

  /* ── Blocks ── */
  .cs-block {
    margin-bottom: 3rem;
  }

  .block-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .block-icon {
    font-size: 1.3rem;
  }

  .block-text {
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  /* ── Responsibilities ── */
  .resp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .resp-card {
    display: flex;
    gap: 0.9rem;
    padding: 1.25rem;
    border-radius: 0.9rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .resp-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .resp-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .resp-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }

  .resp-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Challenges ── */
  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .challenge-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .challenge-num {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
  }

  .challenge-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }

  .challenge-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* ── Sidebar ── */
  .cs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 100px;
  }

  .sidebar-card {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
  }

  .sidebar-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--glass-border);
  }

  /* Outcomes */
  .outcomes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .outcome-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .outcome-value {
    font-size: 1.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .outcome-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Stack */
  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stack-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .stack-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .stack-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-color);
  }

  /* CTA */
  .sidebar-cta {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 15%, transparent),
      color-mix(in srgb, #06b6d4 10%, transparent)
    );
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    text-align: center;
  }

  .cta-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .cta-btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .cs-layout {
      grid-template-columns: 1fr;
    }

    .cs-sidebar {
      position: static;
    }

    .resp-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
