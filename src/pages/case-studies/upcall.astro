---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Contact from "../../components/Contact.astro";

const project = {
  company: "Upcall",
  client: "Devsloop",
  role: "Software Engineer",
  period: "2021 – 2022",
  color: "#ec4899",
  icon: "📞",
  tagline:
    "Full dashboard overhaul, Chargebee billing integration & API monolith migration.",
  overview:
    "Upcall is a B2B platform offering managed outbound calling and lead-generation services. I worked on a complete client-facing dashboard revamp, introduced a self-serve subscription billing system via Chargebee, and led the technical migration from a distributed API architecture to a unified Rails monolith — all while improving database performance.",
  problem:
    "Upcall's existing dashboard was outdated and difficult for clients to navigate. Their billing involved multiple disconnected systems, and the fragmented API architecture made maintenance expensive and deployments risky. Performance issues in the database layer further slowed the product.",
  tags: [
    "Ruby on Rails",
    "Chargebee",
    "Dashboard",
    "Performance",
    "API Migration",
  ],
  stack: [
    { label: "Full-Stack", value: "Ruby on Rails (Monolith)", icon: "💎" },
    { label: "Billing", value: "Chargebee Self-Serve Portal", icon: "💳" },
    { label: "Caching", value: "Redis / Rails Cache", icon: "⚡" },
    { label: "Database", value: "PostgreSQL (optimised)", icon: "🐘" },
    { label: "UI", value: "Modern Dashboard Design", icon: "🎨" },
  ],
  responsibilities: [
    {
      title: "Dashboard Revamp",
      desc: "Rebuilt the client-facing dashboard with an entirely new design, improving usability, data visualisation, and navigation flow for Upcall's business customers.",
      icon: "🎨",
    },
    {
      title: "Chargebee Integration",
      desc: "Implemented a self-serve subscription management portal via Chargebee, allowing clients to upgrade, downgrade, and manage billing without contacting support.",
      icon: "💳",
    },
    {
      title: "API → Monolith Migration",
      desc: "Led the migration from a distributed multi-API architecture to a single, maintainable Rails monolith, reducing operational complexity and deployment risk.",
      icon: "🔄",
    },
    {
      title: "Database Optimisation",
      desc: "Identified slow queries using EXPLAIN ANALYZE, added missing indexes, and introduced a caching layer to dramatically reduce DB load on high-traffic endpoints.",
      icon: "⚡",
    },
  ],
  outcomes: [
    { value: "↑ UX", label: "Fully revamped client dashboard" },
    { value: "1 App", label: "Unified from multiple APIs to monolith" },
    { value: "↓ 60%", label: "DB query load reduction" },
  ],
  challenges: [
    {
      title: "Zero-Downtime API Migration",
      desc: "Migrating from multiple APIs to a monolith without disrupting active clients required a staged approach — first shadowing the old APIs with Rails routes, then gradually deprecating external endpoints while keeping clients unaware of the change.",
    },
    {
      title: "Chargebee Webhook Reliability",
      desc: "Self-serve billing depends on accurate webhook delivery from Chargebee. I implemented idempotent event handling with event deduplication and retry logic to ensure subscription state stayed in sync even during network failures.",
    },
    {
      title: "Dashboard Performance",
      desc: "The new dashboard loaded aggregate data for many clients simultaneously. I introduced query result caching with cache invalidation tied to data-changing events, reducing dashboard load time from seconds to under 200ms.",
    },
  ],
};
---

<Layout
  title={`${project.company} Case Study | Saim Sohail`}
  description={project.tagline}
>
  <Header />
  <main>
    <section class="cs-detail-hero" style={`--accent: ${project.color};`}>
      <div class="container">
        <a href="/case-studies" class="back-link">← All Case Studies</a>
        <div class="hero-meta">
          <span class="hero-icon">{project.icon}</span>
          <div>
            <p class="hero-role">{project.role} · {project.client}</p>
            <h1 class="hero-company">{project.company}</h1>
            <p class="hero-period">{project.period}</p>
          </div>
        </div>
        <p class="hero-tagline">{project.tagline}</p>
        <div class="hero-tags">
          {project.tags.map((t) => <span class="htag">{t}</span>)}
        </div>
      </div>
    </section>

    <section class="cs-body">
      <div class="container cs-layout">
        <div class="cs-main">
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">📋</span> Project Overview
            </h2>
            <p class="block-text">{project.overview}</p>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🎯</span> The Problem
            </h2>
            <p class="block-text">{project.problem}</p>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">⚡</span> My Responsibilities
            </h2>
            <div class="resp-grid">
              {
                project.responsibilities.map((r) => (
                  <div class="resp-card">
                    <span class="resp-icon">{r.icon}</span>
                    <div>
                      <h3 class="resp-title">{r.title}</h3>
                      <p class="resp-desc">{r.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🧩</span> Key Challenges & Solutions
            </h2>
            <div class="challenge-list">
              {
                project.challenges.map((c, i) => (
                  <div class="challenge-item">
                    <div class="challenge-num">{i + 1}</div>
                    <div>
                      <h3 class="challenge-title">{c.title}</h3>
                      <p class="challenge-desc">{c.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <aside class="cs-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">🏆 Outcomes</h3>
            <div class="outcomes">
              {
                project.outcomes.map((o) => (
                  <div class="outcome-item">
                    <span class="outcome-value">{o.value}</span>
                    <span class="outcome-label">{o.label}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="sidebar-card">
            <h3 class="sidebar-title">🛠️ Tech Stack</h3>
            <div class="stack-list">
              {
                project.stack.map((s) => (
                  <div class="stack-item">
                    <span class="stack-icon">{s.icon}</span>
                    <div>
                      <p class="stack-label">{s.label}</p>
                      <p class="stack-value">{s.value}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="sidebar-card sidebar-cta">
            <p class="cta-text">
              Need a billing integration or Rails architecture overhaul?
            </p>
            <a href="/#contact" class="cta-btn">Let's Talk</a>
          </div>
        </aside>
      </div>
    </section>
    <Contact />
  </main>
</Layout>

<style>
  :root {
    --accent: #ec4899;
  }
  .cs-detail-hero {
    padding-top: 140px;
    padding-bottom: 4rem;
    background: radial-gradient(
      ellipse 80% 50% at 50% 0%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 60%
    );
    border-bottom: 1px solid var(--glass-border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    transition: color 0.25s;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .hero-icon {
    font-size: 3.5rem;
    filter: drop-shadow(0 0 20px var(--accent));
  }
  .hero-role {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .hero-company {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-color);
    line-height: 1.1;
  }
  .hero-period {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .hero-tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .htag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }
  .cs-body {
    padding: 4rem 0 6rem;
  }
  .cs-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }
  .cs-block {
    margin-bottom: 3rem;
  }
  .block-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .block-text {
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .resp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .resp-card {
    display: flex;
    gap: 0.9rem;
    padding: 1.25rem;
    border-radius: 0.9rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .resp-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .resp-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .resp-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .resp-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .challenge-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .challenge-num {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .challenge-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .challenge-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .cs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 100px;
  }
  .sidebar-card {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
  }
  .sidebar-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--glass-border);
  }
  .outcomes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .outcome-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .outcome-value {
    font-size: 1.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .outcome-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stack-icon {
    font-size: 1.25rem;
  }
  .stack-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .stack-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-color);
  }
  .sidebar-cta {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 15%, transparent),
      color-mix(in srgb, #8b5cf6 10%, transparent)
    );
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    text-align: center;
  }
  .cta-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .cta-btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  @media (max-width: 900px) {
    .cs-layout {
      grid-template-columns: 1fr;
    }
    .cs-sidebar {
      position: static;
    }
    .resp-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
