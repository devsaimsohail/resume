---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Contact from "../../components/Contact.astro";

const project = {
  company: "Easyllama",
  client: "Devsloop",
  role: "Sr. Software Engineer",
  period: "2022 – 2023",
  color: "#f43f5e",
  icon: "🏥",
  tagline:
    "Three healthcare & compliance platforms built for real-world patients.",
  overview:
    "At Easyllama, I worked on three distinct healthcare and compliance web platforms — Global Encounters, PrepMod, and UvoHealth — each solving a real-world patient access problem. These applications handled sensitive health data and required strict reliability, performance, and compliance standards.",
  problem:
    "Healthcare platforms demand exceptional reliability, data privacy, and UX across geographically diverse user bases. Each of the three products had different complexities: location-based eligibility (Global Encounters), appointment booking at scale (PrepMod), and real-time doctor-patient sessions (UvoHealth).",
  tags: [
    "Ruby on Rails",
    "Telehealth",
    "Vaccination Systems",
    "PostgreSQL",
    "APIs",
    "Healthcare",
  ],
  stack: [
    { label: "Full-Stack", value: "Ruby on Rails", icon: "💎" },
    { label: "Database", value: "PostgreSQL", icon: "🐘" },
    { label: "Telehealth", value: "UvoHealth Patient Portal", icon: "🩺" },
    { label: "Vaccination", value: "PrepMod Portal", icon: "💉" },
    { label: "Geo-Eligibility", value: "Global Encounters", icon: "🌍" },
    { label: "Testing", value: "RSpec / Test Suite", icon: "✅" },
  ],
  responsibilities: [
    {
      title: "Global Encounters",
      desc: "Built location-based eligibility flows allowing users to apply to international programmes based on geography and preferences.",
      icon: "🌍",
    },
    {
      title: "PrepMod (Vaccination Portal)",
      desc: "Developed patient registration and vaccination appointment booking features, enabling clinics to manage high-demand scheduling at scale.",
      icon: "💉",
    },
    {
      title: "UvoHealth (Telehealth Portal)",
      desc: "Implemented patient registration, profile management, and session booking with healthcare providers for virtual consultations.",
      icon: "🩺",
    },
    {
      title: "Third-Party Integrations",
      desc: "Established compatibility with third-party software products by creating custom adapters for modification and integration with external health systems.",
      icon: "🔌",
    },
    {
      title: "Stakeholder Collaboration",
      desc: "Worked with PMs, QA teams, and clients to resolve technical issues and maintain product quality across all three platforms.",
      icon: "🤝",
    },
    {
      title: "Mentorship & Code Reviews",
      desc: "Trained junior engineers on healthcare domain considerations, Rails patterns, and led regular code review cycles.",
      icon: "👨‍🏫",
    },
  ],
  outcomes: [
    { value: "3", label: "Healthcare platforms delivered" },
    { value: "100%", label: "HIPAA-conscious data handling" },
    { value: "↑ UX", label: "Patient access dramatically improved" },
  ],
  challenges: [
    {
      title: "Location-Based Eligibility at Scale",
      desc: "Global Encounters required real-time geolocation matching for programme eligibility. I implemented a performant lookup system using PostGIS-friendly queries and caching layers to serve thousands of concurrent users.",
    },
    {
      title: "High-Traffic Appointment Booking",
      desc: "PrepMod handled surge demand during vaccination campaigns. I introduced background job processing with Sidekiq to handle booking confirmations and email notifications asynchronously, preventing UI timeouts.",
    },
    {
      title: "Reliable Telehealth Sessions",
      desc: "Ensuring UvoHealth session management was reliable required careful state machine design for appointment lifecycle — from booking, through check-in, to session completion — with fallback handling for connectivity issues.",
    },
  ],
};
---

<Layout
  title={`${project.company} Case Study | Saim Sohail`}
  description={project.tagline}
>
  <Header />
  <main>
    <section class="cs-detail-hero" style={`--accent: ${project.color};`}>
      <div class="container">
        <a href="/case-studies" class="back-link">← All Case Studies</a>
        <div class="hero-meta">
          <span class="hero-icon">{project.icon}</span>
          <div>
            <p class="hero-role">{project.role} · {project.client}</p>
            <h1 class="hero-company">{project.company}</h1>
            <p class="hero-period">{project.period}</p>
          </div>
        </div>
        <p class="hero-tagline">{project.tagline}</p>
        <div class="hero-tags">
          {project.tags.map((t) => <span class="htag">{t}</span>)}
        </div>
      </div>
    </section>

    <section class="cs-body">
      <div class="container cs-layout">
        <div class="cs-main">
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">📋</span> Project Overview
            </h2>
            <p class="block-text">{project.overview}</p>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🎯</span> The Problem
            </h2>
            <p class="block-text">{project.problem}</p>
          </div>
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">⚡</span> My Responsibilities
            </h2>
            <div class="resp-grid">
              {
                project.responsibilities.map((r) => (
                  <div class="resp-card">
                    <span class="resp-icon">{r.icon}</span>
                    <div>
                      <h3 class="resp-title">{r.title}</h3>
                      <p class="resp-desc">{r.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Platform spotlight -->
          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🗂️</span> Platform Spotlight
            </h2>
            <div class="platform-cards">
              <div class="platform-card" style="--pc: #f43f5e;">
                <div class="pc-header">
                  <span class="pc-icon">🌍</span>
                  <h3 class="pc-name">Global Encounters</h3>
                </div>
                <p class="pc-desc">
                  Location-based programme application portal with geolocation
                  eligibility filters and preference-based matching for
                  international placements.
                </p>
              </div>
              <div class="platform-card" style="--pc: #10b981;">
                <div class="pc-header">
                  <span class="pc-icon">💉</span>
                  <h3 class="pc-name">PrepMod</h3>
                </div>
                <p class="pc-desc">
                  Patient registration and appointment booking system for
                  vaccination clinics, designed to handle surge demand during
                  national vaccination campaigns.
                </p>
              </div>
              <div class="platform-card" style="--pc: #06b6d4;">
                <div class="pc-header">
                  <span class="pc-icon">🩺</span>
                  <h3 class="pc-name">UvoHealth</h3>
                </div>
                <p class="pc-desc">
                  Telehealth portal for patient registration, profile
                  management, and real-time virtual consultation sessions with
                  licensed healthcare providers.
                </p>
              </div>
            </div>
          </div>

          <div class="cs-block">
            <h2 class="block-title">
              <span class="block-icon">🧩</span> Key Challenges & Solutions
            </h2>
            <div class="challenge-list">
              {
                project.challenges.map((c, i) => (
                  <div class="challenge-item">
                    <div class="challenge-num">{i + 1}</div>
                    <div>
                      <h3 class="challenge-title">{c.title}</h3>
                      <p class="challenge-desc">{c.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <aside class="cs-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">🏆 Outcomes</h3>
            <div class="outcomes">
              {
                project.outcomes.map((o) => (
                  <div class="outcome-item">
                    <span class="outcome-value">{o.value}</span>
                    <span class="outcome-label">{o.label}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="sidebar-card">
            <h3 class="sidebar-title">🛠️ Tech Stack</h3>
            <div class="stack-list">
              {
                project.stack.map((s) => (
                  <div class="stack-item">
                    <span class="stack-icon">{s.icon}</span>
                    <div>
                      <p class="stack-label">{s.label}</p>
                      <p class="stack-value">{s.value}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="sidebar-card sidebar-cta">
            <p class="cta-text">
              Need a Rails engineer for a healthcare or compliance platform?
            </p>
            <a href="/#contact" class="cta-btn">Let's Talk</a>
          </div>
        </aside>
      </div>
    </section>
    <Contact />
  </main>
</Layout>

<style>
  :root {
    --accent: #f43f5e;
  }
  .cs-detail-hero {
    padding-top: 140px;
    padding-bottom: 4rem;
    background: radial-gradient(
      ellipse 80% 50% at 50% 0%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 60%
    );
    border-bottom: 1px solid var(--glass-border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    transition: color 0.25s;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .hero-icon {
    font-size: 3.5rem;
    filter: drop-shadow(0 0 20px var(--accent));
  }
  .hero-role {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .hero-company {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-color);
    line-height: 1.1;
  }
  .hero-period {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .hero-tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .htag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }
  .cs-body {
    padding: 4rem 0 6rem;
  }
  .cs-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }
  .cs-block {
    margin-bottom: 3rem;
  }
  .block-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .block-text {
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .resp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .resp-card {
    display: flex;
    gap: 0.9rem;
    padding: 1.25rem;
    border-radius: 0.9rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }
  .resp-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .resp-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .resp-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .resp-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .platform-cards {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }
  .platform-card {
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--pc) 30%, transparent);
    background: color-mix(in srgb, var(--pc) 8%, transparent);
  }
  .pc-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .pc-icon {
    font-size: 1.4rem;
  }
  .pc-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
  }
  .pc-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .challenge-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .challenge-num {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
  }
  .challenge-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.4rem;
  }
  .challenge-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .cs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 100px;
  }
  .sidebar-card {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
  }
  .sidebar-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--glass-border);
  }
  .outcomes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .outcome-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .outcome-value {
    font-size: 1.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .outcome-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stack-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .stack-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .stack-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-color);
  }
  .sidebar-cta {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 15%, transparent),
      color-mix(in srgb, #8b5cf6 10%, transparent)
    );
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    text-align: center;
  }
  .cta-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .cta-btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  @media (max-width: 900px) {
    .cs-layout {
      grid-template-columns: 1fr;
    }
    .cs-sidebar {
      position: static;
    }
    .resp-grid {
      grid-template-columns: 1fr;
    }
    .platform-cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
